# .htaccess for ramanpandey.com (Apache, IONOS Deploy Now)
# Every directive sits inside an <IfModule> guard so a module the host does not load
# can never turn into a 500. Nothing outside a guard.

# ---- no duplicate URLs: /projects, /articles/foo etc. must 404, not mirror the .html page ----
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# ---- character set, and a type for markdown in case a .md is ever served ----
<IfModule core.c>
  AddDefaultCharset UTF-8
</IfModule>
<IfModule mod_mime.c>
  AddType "text/markdown; charset=UTF-8" .md .markdown
</IfModule>

# ---- compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/markdown
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml image/svg+xml
</IfModule>

# ---- caching: images and fonts long; CSS and JS short (file names are not hashed yet) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---- styled 404 ----
<IfModule core.c>
  ErrorDocument 404 /404.html
</IfModule>

# ---- optional: 301 /index.html (and /dir/index.html) to the clean URL ----
# Disabled by default because mod_rewrite needs AllowOverride FileInfo on the host.
# To enable, uncomment. It matches only the literal request line, so it cannot loop.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/(.*/)?index\.html[\s?] [NC]
#   RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
# </IfModule>
